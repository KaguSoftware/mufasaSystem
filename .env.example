# Copy to .env (repo root) and fill in. Every value is optional for `pnpm build`;
# features turn on as their keys are added. See docs/supabase-setup.md.

APP_URL=http://localhost:3000

# ── Supabase Postgres ────────────────────────────────────────────────
# App runtime: TRANSACTION pooler (port 6543). Supabase > Project Settings > Database > Connection string.
DATABASE_URL=
# Migrations: DIRECT connection (port 5432).
DIRECT_DATABASE_URL=
DATABASE_POOL_MAX=10

# ── Supabase Storage (server only, never expose the service role key) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Better Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini (AI Studio, scene JSON, TTS, recitation feedback) ─────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── iyzico (sandbox first) ───────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── LiveKit (built-in live classes) ──────────────────────────────────
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Academy <no-reply@example.com>

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Internal secrets ─────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Shared secret between web and render-worker
WORKER_SECRET=
